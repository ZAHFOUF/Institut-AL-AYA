<div class="row g-3 {{ mt ?? false ? "mt-2" : ""}}"  >


    <template x-for="f in formulas">

        <div class="col-sm-4">
            <input id="formalasInput" {% if session is defined %}:checked=" {{session.formula.id}} == f.id" x-init="refresh()"{% endif %}
             class="form-check-input" type="radio" name="session[formula]" x-bind:id="`forfait${f.id}`" x-bind:value="f.id" x-bind:data-hours="f.hours" x-bind:data-price="f.price" x-bind:data-days="f.daysPerWeek" style="cursor: pointer;" x-on:click="refresh()">
            <label x-text="`Forfait ${f.hours}h (${f.hoursPerWeek}h/semaine)`" class="form-check-label" x-bind:for="`forfait${f.id}`"> </label>
        </div>

        </template>

</div>

<div class="mt-4 mb-2" id="addSection" style="width: 32%;">
    <label for="additionalHours">{{ 'Heures supplémentaires'|trans }}</label>
    <input type="number" id="additionalHours" name="session[additionalHours]" class="form-control" placeholder="{{ 'Heures supplémentaires'|trans }}" value="0" x-on:input="refresh()">
</div>

<div style="font-size: 15px;" class="mt-4 mb-2">
    <p><strong x-text=" '{{titleHours}}' +  totalHours "></strong></p>
</div>

{% if titleTrif is defined %}
<div style="font-size: 20px;" class="mt-4 mb-2">
    {% if frais is defined and frais %}
             <p x-text=" '{{titleTrif}}' +  {% if frais is defined and frais %} (price == 0 || price == null ? 0 : price - 5) {% else %} price {% endif %}  + '€' "></p>
             <p> {{ "Frais d'inscription"|trans }} : 5€</p>
             <strong style="color: #10a75b;"> {{ 'Total'|trans }} : <strong x-text=" (price == 0 || price == null ? 5 : price) + '€' "></strong></strong>
    {% else %}
             <p><strong x-text=" '{{titleTrif}} ' +  price + '€' "></strong></p>
    {% endif %}
</div>
{% endif %}

