<div class="table-responsive">
    <table class="table table-striped align-middle table-nowrap mb-0 table-hover searchable">
        <thead class="table-light">
             {% include "@CommonTemplate/Tables/head.twig" with {keys:data.getItems()|length > 0 ? data[0]|array_keys : []} %}
        </thead>
        <tbody>

            {% include "@CommonTemplate/Tables/body.twig" with {data:data.getItems()} %}
          
        </tbody>

    </table>



    <div class="navigation d-flex justify-content-center mt-4">
        {{ knp_pagination_render(data) }}
    </div>


</div>