{% set reqMonth = app.request.get('month')|trim('0') %}
<select name="month" aria-label="" class="form-select">
    <option selected  value="">Tout</option>
    <option {{ reqMonth == '1' ? 'selected' : "" }} value="1">Janvier</option>
    <option {{ reqMonth == '2' ? 'selected' : "" }} value="2">Février</option>
    <option {{ reqMonth == '3' ? 'selected' : "" }} value="3">Mars</option>
    <option {{ reqMonth == '4' ? 'selected' : "" }} value="4">Avril</option>
    <option {{ reqMonth == '5' ? 'selected' : "" }} value="5">Mai</option>
    <option {{ reqMonth == '6' ? 'selected' : "" }} value="6">Juin</option>
    <option {{ reqMonth == '7' ? 'selected' : "" }} value="7">Juillet</option>
    <option {{ reqMonth == '8' ? 'selected' : "" }} value="8">Août</option>
    <option {{ reqMonth == '9' ? 'selected' : "" }} value="9">Septembre</option>
    <option {{ reqMonth == '10' ? 'selected' : "" }} value="10">Octobre</option>
    <option {{ reqMonth == '11' ? 'selected' : "" }} value="11">Novembre</option>
    <option {{ reqMonth == '12' ? 'selected' : "" }} value="12">Décembre</option>
</select>