{% set local = app.request.locale %}

{% set selectedFlag = [...flags|filter(flag => flag.key == local)][0] %}
{% set unselectedFlags = [...flags|filter(flag => flag.key != local)] %}


<div class="dropdown ms-1 topbar-head-dropdown header-item">
    <button style="border: none;" type="button" class="btn btn-icon btn-topbar btn-ghost-secondary rounded-circle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" fdprocessedid="zhsuhw">
        <img id="header-lang-img" src="{{selectedFlag.image}}" alt="Header Language" height="20" class="rounded">
    </button>
    <div
        class="dropdown-menu dropdown-menu-end">
        {% for flag in unselectedFlags %}
            {% set keyString = "/" ~ selectedFlag.key ~ "/" %}
            {% set newKeyString = "/" ~ flag.key ~ "/" %}
             <a href="{{app.request.uri|replace({(keyString):newKeyString})}}" class="dropdown-item notify-item language" data-lang="fr" title="{{flag.name}}">
               <img src="{{flag.image}}" alt="user-image" class="me-2 rounded" height="18">
               <span class="align-middle">{{flag.name}}</span>
            </a>
        {% endfor %}
        
    </div>
</div>
