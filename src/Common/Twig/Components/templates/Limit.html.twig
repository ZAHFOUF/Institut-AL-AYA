<select style="width: 50px;margin-left: 10px;" name="limit" class="form-control">


    {% for r in range %}

    <option {{app.request.get("limit") == r ? 'selected' : '' }} value="{{r}}">{{r}}</option>
        
    {% endfor %}
   

  </select>


  <script>
    document.addEventListener("DOMContentLoaded", function() {
      $("select[name='limit']").change((e) => e.target.form.submit() )
    })

</script>