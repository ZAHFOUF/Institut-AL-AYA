<div class="modal fade" id="modal{{count}}" tabindex="-1" role="dialog" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-xl modal-dialog " role="document">
        <div class="modal-content" id="modalContent{{count}}" >

        <div class="modal-header" id="modalHeader{{count}}" >
            <h5 class="modal-title" id="detailsModalLabel">{{title}}</h5>
            <a href="javascript:void(0);" class="btn btn-link link-success fw-medium" data-bs-dismiss="modal">
                <i class="ri-close-line me-1 align-middle"></i> Fermer
            </a>
        </div>

        <div class="modal-body" id="modalBody{{count}}">
            {{block('modal_body')}}
        </div>
</div>
</div>