{% extends '@AgentReportingBundle/main.twig' %}


{% block page_title %}
    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Reporting'|trans, title: 'Reporting professeurs'|trans } ) }}
{% endblock %}

{% block page_content %}
{% set month = app.request.get("month") ?? date("now")|date("m") %}    

    <form  method="get">

        <div class="row">
            <div class="col-xl-10 col-lg-10">

                
                <div class="card">  
                    <div class="card-header align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">{{ 'Reporting professeurs'|trans }} de {{getMonth(month)}}</h4>
                        <div class="card-header align-items-center d-flex">
                            {# Vous avez {{ catalogs.getTotalItemCount }} catalogue(s) #}
                        </div>
                    </div>
                    <div class="card-body">

                              <div class="table-responsive">
    <table class="table table-striped align-middle table-nowrap mb-0 table-hover searchable">
        <thead class="table-light">
             </thead><thead class="table-light">
        <tr><th>Professeur</th>
    
    <th>Mois</th>
    
    <th>Année</th>
    
    <th>Nombre d'H en direct/semaine</th>
    
    <th>Nombre de cours/audios en différé/semaine</th>
    
    <th>Nombre d'élèves</th>
    
    <th>Total Rémunération</th>

    <th>Action</th>
    


</tr></thead>
        
       <tbody>



        {% for r in results %}
    <tr>

        <td>{{ r['Professeur'] }}</td>
        <td>{{ r['Mois'] }}</td>
        <td>{{ r['Année'] }}</td>
        <td>{{ r["Nombre d'H en direct/semaine"] }}</td>
        <td>{{ r['Nombre de cours/audios en différé/semaine'] }}</td>
        <td>{{ r["Nombre d'élèves"] }}</td>
        <td>{{ r['Total Rémunération'] }}</td>
        <td>
            <a href="{{path('back_reporting_prof',{agent:r['profId'],month:r['MoisNum'],year:r['Année']})}}" class="btn btn-sm btn-soft-primary">
                <i class="ri-eye-line"></i> Consulter
              </a>
        </td>
            
        </tr>

        {% endfor %}
             
         
          
          
          
    

   



</tbody>
          
        

    </table>



    <div class="navigation d-flex justify-content-center mt-4">
        
    </div>


</div>
                        
                  
                    </div>
                </div>
            </div>
    
            <div class="col-xl-2 col-lg-2">
                <button style="width: 100%; font-size: 15px;" type="submit" name="export" value="1" class="text-white btn btn-success d-inline-block edit-item-bt">
                    {{ 'Exporter'|trans }} <i style="font-size: 15px;" class="mdi mdi-download"></i>
                </button>
                <div class="card mt-4">
                    <div class="card-header">
                        <div class="d-flex">
                            <div class="flex-grow-1">
                                <h5 class="fs-16">{{ 'Filtrer'|trans }}</h5>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">

                    <div class="mb-2">
                        <label class="form-label">{{ 'Année'|trans }}</label>
                        <input value="{{ app.request.get('year')}}" type="text" name="year" class="form-control" >
                    </div>

                    <div class="mb-2">
                        <label class="form-label">{{ 'Mois'|trans }}</label>
                        {{ include('@CommonTemplate/Filters/month.twig') }}
                    </div>

                    <div class="mb-2">
                        <label class="form-label">{{ 'Professeur'|trans }}</label>
                        <select id="teacher" name="teacher" class="form-control">
                            <option value="">{{ 'Tous'|trans }}</option>
                            {% for teacher in teachers %}
                                <option value="{{ teacher.id }}">{{ teacher.firstName }} {{ teacher.lastName }}</option>
                            {% endfor %}
                        </select>
                    </div>
                   

                        
                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="ri-filter-2-line me-1 align-bottom"></i>
                            {{ 'Rechercher'|trans }}
                        </button>
                        <a href="{{ path('back_reporting_index') }}" class="btn btn-secondary w-100 mt-3">
                            <i class="ri-restart-fill label-icon align-middle"></i>                   
                            {{ 'Réinitialiser'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>


    </form>

   
{% endblock %}



{% block pages_scripts %}
<script type="text/javascript">
       $("#teacher").select2();
   
</script>

{% endblock %}