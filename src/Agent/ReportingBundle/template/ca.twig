{% extends '@AgentReportingBundle/main.twig' %}


{% block page_title %}

    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Reporting'|trans, title: "Comptabilité "|trans } ) }}


    <!-- gridjs css -->
    <link rel="stylesheet" href="{{asset('bundles/commontheme/libs/gridjs/theme/mermaid.min.css')}}">

{% endblock %}

{% block page_content %}
    
{% set year = app.request.get("year") ?? date("now")|date('Y') %}
    <form  method="get">

        <div class="row">
            <div class="col-xl-12 col-lg-12">
                <div class="card">  
                    <div class="card-header align-items-center d-flex">
                        <h4 class="card-title mb-0 flex-grow-1">{{ "Chiffre d'affaires"|trans }} {{year}}</h4>
                        <!-- Button trigger modal -->
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#filterExportModal">
        {{ 'Actions'|trans }}
        <i class="mdi mdi-filter-outline"></i>
    </button>

                    </div>
                    <div class="card-body">
                           {% include "@CommonTemplate/Tables/index.twig" with {data:results} %}
                    </div>
                </div>
            </div>


            <div class="col-8">
                {% set yearStats = toChartYear(results.getItems()) %}
                 <div class="card">
                                <div class="card-header border-0 align-items-center d-flex">
                                    <h4 class="card-title mb-0 flex-grow-1">Indicateur de revenus {{year}}</h4>
                                 
                                </div><!-- end card header -->

                                <div class="card-header p-0 border-0 bg-soft-light">
                                    <div class="row text-center">
                                        <div class="col-4 col-sm-4">
                                            <div class="p-3 border border-dashed border-start-0">
                                                <h5 class="mb-1"><span class="counter-value" data-target="{{yearStats["Total recettes cours"]}}">0</span>
                                                €</h5>
                                                <p class="text-muted mb-0">Total recettes cours</p>
                                            </div>
                                        </div>
                                        <!--end col-->
                                        <div class="col-4 col-sm-4">
                                            <div class="p-3 border border-dashed border-start-0">
                                                <h5 class="mb-1"><span class="counter-value" data-target="{{yearStats["Révenue total"]}}" >0</span>€</h5>
                                                <p class="text-muted mb-0"> Revenus nets total</p>
                                            </div>
                                        </div>
                                        <!--end col-->
                                        <div class="col-4 col-sm-4">
                                            <div class="p-3 border border-dashed border-start-0">
                                                <h5 class="mb-1"><span class="counter-value" data-target="{{yearStats["Total recettes supports de cours"]}}">0</span>
                                                €</h5>
                                                <p class="text-muted mb-0">Total recettes supports de cours</p>
                                            </div>
                                        </div>
                                       
                                        <!--end col-->
                                    </div>
                                </div><!-- end card header -->

                                <div class="card-body p-0 pb-2">
                                    <div>
                                        <div id="customer_impression_charts" data-colors='["--vz-info", "--vz-success", "--vz-primary"]' class="apex-charts"></div>
                                    </div>
                                </div><!-- end card body -->
                            </div><!-- end card -->

            </div>

            <div class="col-4 col-lg-4 mt-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">{{ 'Liste des dépenses'|trans }}</h4>
                 <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addChargeModal">
                {{ 'Ajouter une dépense'|trans }}
            </button>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{ 'Montant'|trans }}</th>
                                <th scope="col">{{ 'Type'|trans }}</th>
                                 <th scope="col">{{ 'Date'|trans }}</th>
                                <th scope="col">{{ 'Prestation'|trans }}</th>
                                <th scope="col">{{ 'Action'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all">
                            {% for charge in charges %}
                                <tr>
                                    <td>{{ charge.price }}€</td>
                                    <td>{{ charge.per ? charge.per.name : '' }}</td>
                                    <td>{{charge.date ? charge.date|date("d-m-Y") : ""}}</td>
                                    <td>{{ charge.provider }}</td>
                                    <td>
                                        <form method="post" action="{{ path('back_charge_delete', {id: charge.id}) }}" style="display:inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette dépense ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_charge_' ~ charge.id) }}">
                                            <button class="btn btn-sm btn-danger" title="Supprimer"><i class="ri-delete-bin-6-line"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="card-footer">
                        <div class="d-flex justify-content-end">
                            <div class="pagination-wrap hstack" style="display: flex; margin-bottom: -14px;">
                                {{ knp_pagination_render(charges) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

      
    
        </div>


            <!-- Modal -->
    <div class="modal fade" id="filterExportModal" tabindex="-1" aria-labelledby="filterExportModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form method="get">
            <div class="modal-header">
              <h5 class="modal-title" id="filterExportModalLabel">{{ 'Exporter / Filtrer'|trans }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Fermer'|trans }}"></button>
            </div>
            <div class="modal-body">
              <button style="width: 100%; font-size: 15px;" type="submit" name="export" value="1" class="text-white btn btn-success d-inline-block edit-item-bt mb-3">
                {{ 'Exporter'|trans }} <i style="font-size: 15px;" class="mdi mdi-download"></i>
              </button>
              <div class="card mt-2">
                <div class="card-header">
                  <div class="d-flex">
                    <div class="flex-grow-1">
                      <h5 class="fs-16">{{ 'Filtrer'|trans }}</h5>
                    </div>
                  </div>
                </div>
                <div class="card-body">
                  <div class="mb-2">
                    <label class="form-label">{{ 'Année'|trans }}</label>
                    <input value="{{ app.request.get('year')}}" type="text" name="year" class="form-control" >
                  </div>
                  <div class="mb-2">
                    <label class="form-label">{{ 'Mois'|trans }}</label>
                    {{ include('@CommonTemplate/Filters/month.twig') }}
                  </div>
                  <button type="submit" class="btn btn-primary w-100 mt-2">
                    <i class="ri-filter-2-line me-1 align-bottom"></i>
                    {{ 'Rechercher'|trans }}
                  </button>
                  <a href="{{ path('back_reporting_index') }}" class="btn btn-secondary w-100 mt-3">
                    <i class="ri-restart-fill label-icon align-middle"></i>
                    {{ 'Réinitialiser'|trans }}
                  </a>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>


          


    </form>

     <div class="modal fade" id="addChargeModal" tabindex="-1" aria-labelledby="addChargeModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addChargeModalLabel">{{ 'Ajouter une dépense'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.price) }}
                                {{ form_widget(form.price) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.per) }}
                                {{ form_widget(form.per) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.provider) }}
                                {{ form_widget(form.provider) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.date) }}
                                {{ form_widget(form.date, {'attr': {'id': 'charge_date'}}) }}
                            </div>
                            <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    const perSelect = document.getElementById('charge_form_per');
                                    const dateDiv = document.getElementById('charge_form_date').closest('.mb-3');
                                    function toggleDateField() {
                                        if (perSelect && perSelect.value == '3') {
                                            dateDiv.style.display = '';
                                        } else {
                                            dateDiv.style.display = 'none';
                                        }
                                    }
                                    if (perSelect && dateDiv) {
                                        toggleDateField();
                                        perSelect.addEventListener('change', toggleDateField);
                                    }
                                });
                            </script>
                            <button type="submit" class="btn btn-success">{{ 'Ajouter'|trans }}</button>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
   
{% endblock %}

{% block pages_scripts %}

 <!-- apexcharts -->
    <script src="{{asset('bundles/commontheme/libs/apexcharts/apexcharts.min.js')}}"></script>

    <!-- gridjs js -->
    <script src="{{asset('bundles/commontheme/libs/gridjs/gridjs.umd.js')}}"></script>
    <script src="https://unpkg.com/gridjs/plugins/selection/dist/selection.umd.js"></script>

  <script>
    // get colors array from the string
function getChartColorsArray(chartId) {
    if (document.getElementById(chartId) !== null) {
        var colors = document.getElementById(chartId).getAttribute("data-colors");
        if (colors) {
            colors = JSON.parse(colors);
            return colors.map(function (value) {
                var newValue = value.replace(" ", "");
                if (newValue.indexOf(",") === -1) {
                    var color = getComputedStyle(document.documentElement).getPropertyValue(
                        newValue
                    );
                    if (color) return color;
                    else return newValue;
                } else {
                    var val = value.split(",");
                    if (val.length == 2) {
                        var rgbaColor = getComputedStyle(
                            document.documentElement
                        ).getPropertyValue(val[0]);
                        rgbaColor = "rgba(" + rgbaColor + "," + val[1] + ")";
                        return rgbaColor;
                    } else {
                        return newValue;
                    }
                }
            });
        } else {
            console.warn('data-colors atributes not found on', chartId);
        }
    }
}

var linechartcustomerColors = getChartColorsArray("customer_impression_charts");
console.log(linechartcustomerColors);
if (linechartcustomerColors) {
    var options = {
        series: JSON.parse('{{toChart(results.getItems())|raw}}'),
        chart: {
            height: 370,
            type: "line",
            toolbar: {
                show: false,
            },
        },
        stroke: {
            curve: "straight",
            dashArray: [0, 0, 8],
            width: [2, 0, 2.2],
        },
        fill: {
            opacity: [0.1, 0.9, 1],
        },
        markers: {
            size: [0, 0, 0],
            strokeWidth: 2,
            hover: {
                size: 4,
            },
        },
        xaxis: {
            categories: JSON.parse('{{toChartMonth(results.getItems())|raw}}'),
            axisTicks: {
                show: false,
            },
            axisBorder: {
                show: false,
            },
        },
        grid: {
            show: true,
            xaxis: {
                lines: {
                    show: true,
                },
            },
            yaxis: {
                lines: {
                    show: false,
                },
            },
            padding: {
                top: 0,
                right: -2,
                bottom: 15,
                left: 10,
            },
        },
        legend: {
            show: true,
            horizontalAlign: "center",
            offsetX: 0,
            offsetY: -5,
            markers: {
                width: 9,
                height: 9,
                radius: 6,
            },
            itemMargin: {
                horizontal: 10,
                vertical: 0,
            },
        },
        plotOptions: {
            bar: {
                columnWidth: "30%",
                barHeight: "70%",
            },
        },
        colors: linechartcustomerColors,
        tooltip: {
            shared: true,
            y: [{
                    formatter: function (y) {
                        if (typeof y !== "undefined") {
                            return y.toFixed(0) + "€";
                        }
                        return y;
                    },
                },
                {
                    formatter: function (y) {
                        if (typeof y !== "undefined") {
                            return  y.toFixed(2) + "€";
                        }
                        return y;
                    },
                },
                {
                    formatter: function (y) {
                        if (typeof y !== "undefined") {
                            return y.toFixed(0) + "€";
                        }
                        return y;
                    },
                },
            ],
        },
    };
    var chart = new ApexCharts(
        document.querySelector("#customer_impression_charts"),
        options
    );
    chart.render();
}
  </script>
{% endblock %}