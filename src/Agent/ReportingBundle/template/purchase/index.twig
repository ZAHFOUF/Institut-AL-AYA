{% extends '@AgentReportingBundle/main.twig' %}

{% block page_title %}
    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Reporting', title: 'Achats'} ) }}
{% endblock %}

{% block page_content %}
<div class="row">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">{{ 'Liste des achats'|trans }}</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">
                    <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">{{ 'Numéro'|trans }}</th>
                                <th scope="col">{{ 'Produit'|trans }}</th>
                                <th scope="col">{{ 'Montant'|trans }}</th>
                                <th scope="col">{{ 'Date de l\'achat'|trans }}</th>
                                <th scope="col">{{ 'Étudiant'|trans }}</th>
                                <th scope="col">{{ 'Action'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody class="list form-check-all">
                            {% for purchase in purchases %}
                                <tr>
                                    <td>{{ purchase.id }}</td>
                                    <td>{{ purchase.name }}</td>
                                    <td>{{ purchase.price }}€</td>
                                    <td>{{ purchase.date ? purchase.date|date('d/m/Y') : '' }}</td>
                                    <td>{{ purchase.student ? purchase.student.lastName ~ ' ' ~ purchase.student.firstName : '' }}</td>
                                    <td>
                                        <form method="post" action="{{ path('back_purchase_delete', {id: purchase.id}) }}" style="display:inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet achat ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_purchase_' ~ purchase.id) }}">
                                            <button class="btn btn-sm btn-danger" title="Supprimer"><i class="ri-delete-bin-6-line"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="card-footer">
                        <div class="d-flex justify-content-end">
                            <div class="pagination-wrap hstack" style="display: flex; margin-bottom: -14px;">
                                {{ knp_pagination_render(purchases) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        {# Section filtre #}
        <div class="card mb-3">
            <div class="card-header align-items-center d-flex">
                <h5 class="card-title mb-0 flex-grow-1">{{ 'Filtrer les achats'|trans }}</h5>
            </div>
            <div class="card-body">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label for="filter_name" class="form-label">{{ 'Produit'|trans }}</label>
                        <input type="text" id="filter_name" name="name" value="{{ app.request.get('name') }}" class="form-control" placeholder="{{ 'Nom du produit'|trans }}">
                    </div>
                    <div class="col-md-6">
                        <label for="filter_date" class="form-label">{{ 'Date'|trans }}</label>
                        <input type="date" id="filter_date" name="date" value="{{ app.request.get('date') }}" class="form-control">
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-primary">{{ 'Filtrer'|trans }}</button>
                        <a href="{{ path('back_purchase_index') }}" class="btn btn-outline-secondary ms-2">{{ 'Réinitialiser'|trans }}</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">{{ 'Ajouter un achat'|trans }}</h4>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.price) }}
                        {{ form_widget(form.price) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.date) }}
                        {{ form_widget(form.date) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.student) }}
                        {{ form_widget(form.student) }}
                    </div>
                    <button type="submit" class="btn btn-success">{{ 'Ajouter'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
