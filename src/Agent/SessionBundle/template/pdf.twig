<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; }
    .header { background-color: #bdab7d; color: white; padding: 10px; text-align: center; }
    .section-title { background-color: #f0f0f0; padding: 6px; font-weight: bold; margin-top: 20px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #ccc; padding: 6px; text-align: left; }
    .total { text-align: right; font-weight: bold; }
  </style>
</head>
<body>

  <div class="header">
    <h2>Institut Al-Ayah</h2>
    <p>Facture - {{ facture.numero }}</p>
  </div>

  <p><strong>Date :</strong> {{ facture.date|date('d/m/Y') }}</p>
  <p><strong>Élève :</strong> {{ eleve.nom }} {{ eleve.prenom }}</p>
  <p><strong>Email :</strong> {{ eleve.email }}</p>

  <div class="section-title">Détails du forfait</div>
  <table>
    <thead>
      <tr>
        <th>Programme</th>
        <th>Type</th>
        <th>Quantité</th>
        <th>Tarif unitaire</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {% for ligne in facture.forfait %}
      <tr>
        <td>{{ ligne.programme }}</td>
        <td>{{ ligne.type }}</td>
        <td>{{ ligne.quantite }}</td>
        <td>{{ ligne.tarif }} €</td>
        <td>{{ ligne.total }} €</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Autres éléments</div>
  <table>
    <thead>
      <tr>
        <th>Désignation</th>
        <th>Montant</th>
      </tr>
    </thead>
    <tbody>
      {% for extra in facture.extras %}
      <tr>
        <td>{{ extra.label }}</td>
        <td>{{ extra.amount }} €</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p class="total">Montant total : {{ facture.total }} €</p>

</body>
</html>
