{% extends '@AgentReportingBundle/main.twig' %}


{% block page_title %}
    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Prestations'|trans, title: 'Prestations'|trans } ) }}
{% endblock %}

{% block page_content %}
    

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="card-title mb-0">Suivi des prestations</h5>
      <button style="background-color: #bdab7d;color: #FFF;" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addProgrammeModal">
      <i class="ri-add-line"></i> Ajouter une prestation
    </button>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle table-bordered">
        <thead class="table-light">
          <tr>
            <th scope="col">Étudiant / Groupe</th>
            <th scope="col">Programme</th>
            <th>Professeur(e) référent(e) </th>
            <th scope="col">Forfait</th>
            <th scope="col">À facturer</th>
            <th>Statut</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          {% for prestation in prestations %}
          <tr>
            <td>{{prestation.getClientName()}}</td>
            </td>
            <td>{{ prestation.programme.name }}</td>
            <td>{{ prestation.agent.lastName }} {{ prestation.agent.firstName }}</td>
            <td>{{ prestation.formula.name }} - {{ prestation.formula.price }}€/H</td>
            <td><twig:Status :state="prestation.status" /></td>
            <td>{{calculerTotalPrestation(prestation)}}€</td>
            <td>
              <a href="{{path('back_prestation_show',{prestation:prestation.id})}}" class="btn btn-sm btn-soft-primary">
                <i class="ri-eye-line"></i> Consulter
              </a>
            </td>
          </tr>
          {% endfor %}
        
         
        </tbody>
      </table>
    </div>
  </div>
</div>

    <div class="modal fade" id="addProgrammeModal" tabindex="-1" aria-labelledby="addProgrammeModalLabel" aria-hidden="true">
      <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addProgrammeModalLabel">Ajouter une prestation</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body">
               {{form_start(form,{method:'POST'}) }}
                {{ form_widget(form) }}
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary btn-alayah">Enregistrer</button>
        </div>
            {{ form_end(form) }}
      </div>
      </div>
    </div>
   
{% endblock %}



{% block pages_scripts %}
<script type="text/javascript">
       $("#teacher").select2();
   
</script>

{% endblock %}