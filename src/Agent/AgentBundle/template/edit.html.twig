{% extends '@AgentAgentBundle/main.twig' %}


{% block page_title %}
    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: ' Administration ', title: 'Modifier un Utilisateur'} ) }}
{% endblock %}

{% block page_content %}



        <div class="card p-5">

          {{form_start(form , {'attr' : { 'enctype' :"multipart/form-data"  }} )}}

          <div class="row">


          <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Identifiant'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.username) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.username) }}
              </div>
              </div>                    
            </div>
      
      
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Email'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.email) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.email) }}
              </div>
              </div>                    
            </div>
      
      
          
      
          <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Nom'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.lastname) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.lastname) }}
              </div>
              </div>                    
            </div>
      
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Prénom'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.firstname) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.firstname) }}
              </div>
              </div>                    
            </div>

            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Sexe'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.gender) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.gender) }}
              </div>
              </div>                    
            </div>


            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Modules'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.module) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.module) }}
              </div>
              </div>                    
            </div>



            {% include "@CommonTemplate/Sessions/index.twig" %}

            {{ form_row(form.maxHours) }}
            
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Prix par heure'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.price) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.price) }}
              </div>
              </div>                    
            </div>

            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">{{ 'Type utilisateur'|trans }} <span class="text-danger">*</span></label>
                {{ form_row(form.type) }}
                <div class="invalid-feedback text-danger">
                  {{ form_errors(form.type) }}
              </div>
              </div>                    
            </div>

            
            <div class="col-lg-6 col-md-6">

              <label  class="form-label">{{ 'Roles'|trans }}</label>
              <select class="form-control" id="choices-multiple-remove-button" data-choices  data-choices-removeItem name="roles[]" multiple>
                 {% for permission in all %}
                 {% set select = false %}

                 {% for us in usr %}

                 {% if us.getRole.getId == permission.id %} {% set select = true %}{% endif %}
                 
                  
                 {% endfor %}

                 <option   {{ select ? 'selected' : ''}} value="{{permission.id}}">{{permission.name}}</option>
                  
                 {% endfor %}
              </select>

          </div>

              
              <div class="col-md-6 mt-2">
                  <div class="mb-3 d-flex">
      
                    {{ form_row(form.enabled , { 'attr' : { 'style' : 'cursor:pointer;'} }) }}
      
                    <span style="margin-left: 10px;">{{ 'Utilisateur Activé'|trans }}</span>
                    
                   
                  </div>                    
                </div>

                <div class="col-md-6 mt-2">
                  <div class="mb-3 d-flex">
      
                    {{ form_row(form.dispo , { 'attr' : { 'style' : 'cursor:pointer;'} }) }}
      
                    <span style="margin-left: 10px;">{{ 'Disponible'|trans }}</span>
                    
                   
                  </div>                    
                </div>

                

              <div class="col-md-4 mt-3">

                <button type="submit" class="btn btn-success" id="add-btn">{{ 'Modifier'|trans }}</button>
                
              </div>
      
                
  
                {{form_end(form)}}

              </div>


        </div>

      </div>

     

        
    </div>

   



   </div>

 



{% endblock %}
{% block pages_scripts %}
   <script>

    document.querySelector("#session\\[timezone\\]").value = "{{agent.timezone}}"

    {% for day in  agent.availability %}
         $("#{{day}}").click()
    {% endfor %}

    {% for day in  agent.days %}
         selectChoices[0]._presetOptions.forEach(e => { e.value == "{{day}}" ? selectChoices[0].setChoiceByValue(e.value) : "" })
   {% endfor %}

   async function getTimeZones() {

    try {

        const response = await fetch("https://api.timezonedb.com/v2.1/list-time-zone?key=JH7ZZEK2X9RJ&format=json&");

        const data = await response.json();

        if (data.status === 'OK') {

            data.zones.forEach(zone => {

                const countryName = zone.countryName;

                const gmtOffset = zone.gmtOffset / 3600; // Convert seconds to hours

                $("#session\\[timezone\\]").append(`<option value='${countryName} GMT + ${gmtOffset}'>${countryName} GMT + ${gmtOffset}</option>`);

            });

            $("#session\\[timezone\\]").select2();
            {% if session is defined and session.timezone %}
                $("#session\\[timezone\\]").val('{{session.timezone}}').trigger('change');
            {% endif %}

        } else {

            console.error('Error fetching data:', data.message);

        }

    } catch (error) {

        console.error('Error fetching timezones:', error);

    }

}



// Call getTimeZones when document is ready

$(document).ready(function() {

    getTimeZones();

});
   </script>
{% endblock %}