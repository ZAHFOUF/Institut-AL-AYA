{% extends '@MERKEZAdminSessionBundle/main.twig' %}


{% block page_title %}
    {{ include('@AgentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Étudiants'|trans, title: 'Consulter une classe'|trans} ) }}
{% endblock %}

{% block page_content %}

<div class="row">
    <div class="col-lg-8">
        <div class="card">

            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'Modifer les Informations de la classe'|trans }} {{group.name}} {% if group.bySystem %}
                    <twig:BySystem :icon="false"/>
                {% endif %}  </h5> 
                
            </div>

            <div class="card-body">
 
                <div class="row">

                    {{ form_start(form, {'attr': {'id': 'form'}}) }}
                    {{ form_widget(form)}}
                    {{ form_end(form) }}
               
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
        

        <form id="abandonForm" method="POST" action="{{ path('back_group_abandon',{'group':group.id}) }}">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h5 class="card-title mb-0 flex-grow-1">{{ 'Les membres'|trans }}</h5>
                <div class="d-flex gap-1 flex-wrap">
                    <button id="abandonButton" type="submit" class="btn btn-danger btn-label rounded-pill" >
                        <i style="right: -7px;" class=" ri-forbid-2-line  label-icon align-middle rounded-pill fs-16 me-2"></i>{{ 'Abandonner'|trans }}
                    </button>
                    <button id="sendMailButton" type="button" class="btn btn-primary btn-label rounded-pill"><i style="right: -7px;" class=" ri-mail-send-fill label-icon align-middle rounded-pill fs-16 me-2"></i>{{ 'Notifier'|trans }}</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive table-card">

                <table class="table table-borderless table-centered align-middle table-nowrap mb-0" id="groupsTable">
                    <thead class="table-light">
                        <tr>
                            <th style="    width: 100px;" scope="col" class="searchable-cell">
                                <div class="form-check ">
                                    <input class="form-check-input" type="checkbox" value="" id="cardtableCheck">
                                </div>
                            </th>
                          <th scope="col">{{ 'Nom complet'|trans }}</th>
                            <th scope="col">{{ 'Statut'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="list form-check-all">

                        {% for s in activeStudents %}
                               <tr>
                                <td>
                                    <div class="form-check">
                                        <input name="choises[]" data-email="{{s.email}}" value="{{s.id}}" type="checkbox" class="form-check-input ms-0 check">
                                        <label class="form-check-label" for="cardtableCheck02"></label>
                                    </div>
                                </td>
                                   <td> <a href="{{path('back_student_edit',{id:s.id})}}">{{s.lastName}} {{s.firstName}} </a></td>
                                   <td>
                                        <span class="badge text-bg-success">{{ 'Active'|trans }}</span>
                                   </td>
                               </tr>
                        {% endfor %}

                        {% for s in canceledStudents %}

                        <tr>
                            <td>
                               
                            </td>
                               <td> <a href="">{{s.lastName}} {{s.firstName}} </a></td>
                               <td>
                                <span class="badge text-bg-danger">{{ 'Abandon'|trans }}</span>
                               </td>
                           </tr>
                     {% endfor %}
                         
                    </tbody>
                </table>

                </div>

            </div>
        </div>
        </form>
        <!-- end card -->

      
        
        <div class="text-end mb-4">

    

        </div>

        
       

        
    </div>
    <!-- end col -->
    <div class="col-lg-4">

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'Ajouter des nouveaux membres'|trans }}</h5>
            </div>
            <div class="card-body">
                  
                <div class="card-body">
                    <form method="POST" name="newStudents">
                        <label for="">{{ 'Sélectionner les nouveaux membres'|trans }}</label>
                        <select id="students" name="students[]" data-choices multiple class="from-select">
                                   {% for s in students %}
                                   {% if s.id not in group.getStudents() and s.id not in group.getCancelStudents() %}
                                        <option value="{{s.id}}">{{s.name}}</option>
                                   {% endif %}
                                   
                                               
                                   {% endfor %}
                        </select>

                        <div class="mt-3"><button type="submit" id="group_form_save" name="group_form[save]" class="btn btn-primary">{{ 'Ajouter'|trans }}</button></div>

                  </form>
             
 

</div>
              
                
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

         

            
          
            <!-- end card -->
        
       
</div>


<div class="col-lg-8">
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="card-title mb-0">{{ 'Sessions'|trans }}</h5>
        </div>
        
        <div class="card-body">
            <div class="table-responsive table-card">
                <table class="table table-borderless table-centered align-middle table-nowrap mb-0" id="sessionsTable">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'Numéro'|trans }}</th>
                            <th scope="col">{{ 'Module'|trans }}</th>
                            <th scope="col">{{ 'Mois'|trans }}</th>
                            <th scope="col">{{ 'Date'|trans }}</th>
                            <th scope="col">{{ 'Statut'|trans }}</th>
                            <th scope="col">{{ 'Heures prévues'|trans }}</th>
                            <th>{{ 'Action'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="list form-check-all">
                        {% for s in sessions %}
                           {% set session = s.session %}
                            <tr>
                                <td> <a target="_blank" href="{{path('back_session_edit',{session:session.id})}}">{{session.id}}</a></td>
                                <td>{{ session.module.name }}</td>
                                <td>{{getMonth(session.dateStart|date('m'))}}</td>
                                <td>{{ session.dateStart ? session.dateStart|date('d/m/Y') : '' }}</td>
                                <td>  <twig:Status :status="session.status.name" /></td>
                                <td>{{ session.hours ?: '' }}</td>
                                <td>
                                    <a href="{{path('back_session_edit',{session:session.id})}}" type="button" class="btn btn-sm btn-primary ">{{ 'Consulter'|trans }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
    
                <div class="card-footer">
                    <div class="d-flex justify-content-end">
                        <div class="pagination-wrap hstack" style="display: flex; margin-bottom: -14px;">
                            {{ knp_pagination_render(sessions) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- end card body -->
    </div>

</div>



</div>

{% endblock %}

{% block pages_scripts %}
   <script>
   document.addEventListener('DOMContentLoaded', function() {
       const cardTableCheck = document.getElementById('cardtableCheck');
       const otherCards = document.querySelectorAll('.card-body input[type="checkbox"]:not(#cardtableCheck)');

       cardTableCheck.addEventListener('click', function() {
           const isChecked = cardTableCheck.checked;
           otherCards.forEach(card => {
               card.checked = isChecked;
           });
       });
   });

   document.getElementById('sendMailButton').addEventListener('click', function() {
       const checkedStudents = Array.from(document.querySelectorAll('input[name="choises[]"]:checked'));
       const emails = checkedStudents.map(student => student.getAttribute('data-email')).join(',');
       
       if (emails) {
           window.location.href = `mailto:${emails}`;
       } else {
           alert('Veuillez sélectionner au moins un étudiant.');
       }
   });

   document.getElementById('abandonButton').addEventListener('click', function(event) {
       event.preventDefault(); // Prevent the default form submission
       Swal.fire({
           title: 'Êtes-vous sûr?'|trans,
           text: "Vous allez abandonner les étudiants sélectionnés!"|trans,
           icon: 'warning',
           showCancelButton: true,
           confirmButtonColor: '#d33',
           cancelButtonColor: '#3085d6',
           confirmButtonText: 'Abandonner!'|trans,
           cancelButtonText: 'Annuler'|trans
       }).then((result) => {
           if (result.isConfirmed) {
               document.getElementById('abandonForm').submit(); // Submit the form if confirmed
           }
       });
   });
   </script>
   <script>
    document.addEventListener('DOMContentLoaded', function() {
        const copyButton = document.getElementById('copyButton');
        const textToCopy = document.getElementById('textToCopy');
        const copyFeedback = document.querySelector('.copy-feedback');
        const buttonText = copyButton.querySelector('.button-text');
        
        copyButton.addEventListener('click', function() {
            // Select the text
            textToCopy.select();
            textToCopy.setSelectionRange(0, 99999); // For mobile devices
            
            // Try to copy using the Clipboard API first
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                navigator.clipboard.writeText(textToCopy.value)
                    .then(() => {
                        showCopiedFeedback();
                    })
                    .catch(err => {
                        console.warn('Clipboard API failed:', err);
                        // Fall back to execCommand
                        fallbackCopyTextToClipboard();
                    });
            } else {
                // Fallback for browsers that don't support the Clipboard API
                fallbackCopyTextToClipboard();
            }
        });
        
        function fallbackCopyTextToClipboard() {
            try {
                // Try to use the older execCommand method
                const successful = document.execCommand('copy');
                if (successful) {
                    showCopiedFeedback();
                } else {
                    console.warn('Unable to copy using execCommand');
                    showManualCopyMessage();
                }
            } catch (err) {
                console.error('Failed to copy text: ', err);
                showManualCopyMessage();
            }
        }
        
        function showCopiedFeedback() {
            // Show success feedback
            copyButton.classList.add('copied');
            buttonText.textContent = 'Copied!'|trans;
            copyFeedback.style.display = 'block';
            
            // Reset after 2 seconds
            setTimeout(() => {
                copyButton.classList.remove('copied');
                buttonText.textContent = 'Copy to Clipboard'|trans;
                copyFeedback.style.display = 'none';
            }, 2000);
        }
        
        function showManualCopyMessage() {
            // Show a message instructing manual copy
            alert('Please press Ctrl+C or Cmd+C to copy the text manually.'|trans);
        }
    });
</script>
{% endblock %}