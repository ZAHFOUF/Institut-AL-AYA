{% extends '@StudentThemeBundle/base.html.twig' %}

{% block page_title %}
    {{ include('@StudentThemeBundle/partials/page-title.html.twig', {pagetitle: 'Accueil', title: 'Accueil'} ) }}
{% endblock %}

{% block page_content %}
<div class="row">
    <div class="col-md-8">
        <form action="" name="profile_form" method="post">

            <div class="card" style="padding: 30px;">
                <div class="card-header">
                    <h5 class="card-title">Mon profile</h5>
                </div>
                <div class="card-body">
                    {% include "@StudentSecurityBundle/steps/step4.twig" with {user:app.user} %}
                </div>
            </div>

        </form>
     
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
              <h4 class="card-title mb-0 flex-grow-1">Modifier le mot de passe</h4>
            </div>
            <div class="card-body">
                     {% include "@CommonTemplate/User/password.twig" %}
            </div>
          </div>
    </div>
</div>
    
{% endblock %}
