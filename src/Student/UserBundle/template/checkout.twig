{% extends '@StudentThemeBundle/base.html.twig' %}


{% block page_content %}
<script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id }}&currency=EUR"></script>


<div class="container">

    
<div class="row">

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h4 class="mb-0">Détails de la prestation</h4>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Programme
                        <span>Tuhfat Al-Atfâl	(Coran)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Nombre d'heures
                        <span>4</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Livres inclus
                        <span>Tuhfat Al-Atfâl PDF</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center font-weight-bold">
                        Total à payer
                        <span style="color:#13c56b;font-size:18px;">36,00 €</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

 <div class="col-md-6">

    <h4 style="    color: #000;
    margin-top: 12px;
    text-align: left;
    font-size: 20px;" class="card-title mb-0">Méthodes de paiements</h4>

    <div class="row" style="margin-top: 23px;">
    
    
    <div class="col-md-12 animate__fadeInLeft animate__animated" id="s-1">
    
        <div class="card">
            <div class="card-header">
                <div class="d-flex">
                    <div class="flex-grow-1">
                        <h5 class="card-title mb-0">Paiement online (les frais de transaction sont ajoutés)</h5>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="paypal-button-container"></div>
            </div>
            <!-- end card body -->
        </div>
 
     </div>
    
    
    
        <div class="col-md-6 animate__fadeInRight animate__animated" id="s-2">
         <h3 style=" color: #13c56b !important;text-align:left;" class="mt-0 "></h3> 
    
    
       </div>
        
    
      </div>

 </div>
    

</div>


</div>




    
{% endblock %}

{% block pages_scripts %}
<script>
    paypal.Buttons({
        createOrder: function(data, actions) {
            return fetch('{{path('paypal_create_order')}}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: '70' })
            })
            .then(response => response.json())
            .then(data => {
                return data.id;
            });
        },
        onApprove: function(data, actions) {
            return actions.order.capture().then(function(orderData) {
                fetch('{{path('paypal_capture_order')}}', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(orderData)
                })
                .then(response => response.json())
                .then(data => {
                    window.location.href = '{{path('student_payements')}}' })
                .catch(error => console.error('Error:', error));
            });
        }
    }).render('#paypal-button-container');
</script>
{% endblock %}
