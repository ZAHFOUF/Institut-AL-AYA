
{% extends '@StudentThemeBundle/base.html.twig' %}


{% block page_content %}

<div class="row">

    <div class="col-6">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">Paiements a régler</h4>
                <div class="d-flex gap-1 flex-wrap">
                 
                </div>
            </div>
            <div class="card-body">
        <div class="table-responsive">
            <table class="table table-borderless align-middle table-nowrap mb-0">
                <thead>
                    <tr>
                        <th>Programme</th>
                        <th scope="col">Montant à payer</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                     {% for bill in bills %}
                         <tr>
                            <td>{{bill.prestation.programme.name}}</td>
                            <td>{{amountBill(bill)}}</td>
                            <td>
                                <a href="{{path('student_checkout', {'id': bill.id})}}" class="btn btn-primary btn-sm">Effectuer le paiement</a>
                            </td>
                         </tr>
                     {% endfor %}
                  
                </tbody>
            </table>
        </div>
        </div>


    </div>
    </div>

  
</div>
    
   

{% endblock %}