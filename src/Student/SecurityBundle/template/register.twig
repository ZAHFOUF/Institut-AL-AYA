
{% block page_content %}

{{ include('@AgentThemeBundle/partials/main.html.twig') }}
<head>
    {{ include('@AgentThemeBundle/partials/title-meta.html.twig') }}
    {{ include('@AgentThemeBundle/partials/head-css.html.twig') }}
    {% block stylesheets %}
    {% endblock %}

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root {
            --primary-color: #405189;
            --card-shadow: 0 1px 2px rgba(56,65,74,.15);
            --card-hover-shadow: 0 .75rem 1.5rem rgba(18,38,63,.03);
        }
        body {
            background: linear-gradient(to bottom, var(--colors--gold1), var(--colors--gold2) 50%,var(--colors--gold3));
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        .wave-shape {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 250px;
            background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.3));
            clip-path: polygon(0 40%, 100% 0%, 100% 100%, 0% 100%);
        }

        .main-shadow{box-shadow: rgba(50, 50, 93, 0.25) 0px 13px 27px -5px, rgba(0, 0, 0, 0.3) 0px 8px 16px -8px !important;}
        #arabe,#coran{cursor: pointer;}
        .selected{    opacity: 0.5;
            border: #000 solid 2px;}
        #type1,#type2,#type3{cursor: pointer;}
        .grey-back{    background-color: var(--vz-body-bg) !important;}
    </style>

</head>
<body>
    
    <style>
        @media screen and (max-width: 768px) {
            .container-fluid {
                --vz-gutter-x: 1rem; /* Reduce gutter for better spacing */
                --vz-gutter-y: 0;
                width: 100%;
                max-width: 100%;
                padding: 0  10px !important; /* Reduce excessive padding */
                margin-right: auto;
                margin-left: auto;
            }

            .icon-box{margin-left: -6px !important;}
        
            #mainImg img {width: 222px !important;}

            #typeCours{margin-left: 0px !important;}

            #addSection{width: 70% !important;}
          
        }
        

    </style>

    <div id="preloader" style="background-color: #0000007a;display:none !important;opacity: 1;visibility: visible !important;">
        <div id="status">
            <div class="spinner-border text-primary avatar-sm" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
   {#} style="    background-image: linear-gradient(273deg, var(--colors--gold1), var(--colors--gold2) 50%, var(--colors--gold3));" #}
    <div class="wave-shape"></div>
    <div class="auth-page-wrapper py-5 d-flex justify-content-center align-items-center min-vh-100">
        <div style="background-color: #0000001a !important;" class="bg-overlay"></div>
        <!-- auth-page content -->
        <div class="auth-page-content overflow-hidden pt-lg-5" >
            <div class="container-fluid" style="padding: 0 100px;">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card overflow-hidden m-0">
                            <div class="row justify-content-center g-0">
                                <div class="col-lg-4" id="mainImg">
                                    <div style="background-color: #000;" class="p-lg-5 p-4 h-100">
                                        <div class="bg-overlay"></div>
                                        <div style="display: grid !important;place-content: center;" class="position-relative h-100 d-flex flex-column">
                                            <div class="mb-4">
                                                <a href="/" class="d-block">
                                                    <img style="    width: 284px;margin-top: 24px;" src="/bundles/commontheme/images/logo/logo.png" alt="">
                                                </a>
                                            </div>
                                       
                                        </div>
                                    </div>
                                </div>
    
                                <div class="col-lg-8">

                                    <div class="p-lg-5 p-4" style="    margin-bottom: -22px;">
                                        <form id="mainForm" method="post" x-data="initFormula()"  x-init="loadFormulas()" class="form-steps" autocomplete="off">


                                        <div style="    padding-bottom: 20px;">
                                            <h5 class="text-dark text-center">Inscrivez-vous</h5>
                                        </div>

                                    <div class="step-arrow-nav mb-4">

                                        <ul class="nav nav-pills custom-nav nav-justified" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active" id="step1-tab" data-bs-toggle="pill" data-bs-target="#step1" type="button" role="tab" aria-controls="steparrow-course" aria-selected="true">Cours</button>
                                            </li>

                                             <li class="nav-item" role="presentation">
                                                <button disabled class="nav-link " id="step2-tab" data-bs-toggle="pill" data-bs-target="#step2"  type="button" role="tab" aria-controls="steparrow-gen-info" aria-selected="false">Formules</button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button disabled class="nav-link " id="step3-tab"  data-bs-toggle="pill" data-bs-target="#step3"  type="button" role="tab" aria-controls="steparrow-gen-info" aria-selected="false">Disponibilité</button>
                                            </li>
                                           
                                            <li class="nav-item" role="presentation">
                                                <button disabled class="nav-link" id="step4-tab" data-bs-toggle="pill" data-bs-target="#step4" type="button" role="tab" aria-controls="pills-experience" aria-selected="false">Informations personnelles</button>
                                            </li>

                                        </ul>
                                    </div>


                                    <div class="tab-content">

                                            {% include "@StudentSecurityBundle/steps/step1.twig" %}

    
                                            {% include "@StudentSecurityBundle/steps/step3.twig" with {first:true} %}

                                            {% include "@StudentSecurityBundle/steps/step2.twig" %}
    
                                            {% include "@StudentSecurityBundle/steps/step4.twig" %}

                                    </div>

                                  
    
  



</form>

                                        </div>

                                        <div class="mt-3 text-center" style="padding-bottom: 26px;">
                                            <p class="mb-0">Vous avez déjà un compte ? <a href="{{path('tech_student_login')}}" class="fw-semibold text-primary text-decoration-underline"> Connectez-vous</a> </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end card -->
                    </div>
                    <!-- end col -->
    
                </div>
                <!-- end row -->
            </div>
            <!-- end container -->
        </div>
        <!-- end auth page content -->
    
    </div>
   {% include "@StudentThemeBundle/partials/vendor-scripts.html.twig" %}
    <script>
         
         

        $("#mainForm").submit(function(e){
            e.preventDefault()
            $("#preloader").show()
            $.ajax({
                type: "POST",
                url: "{{ path('tech_student_register') }}",
                data: $("#mainForm").serialize(),
                success: function(response) {
                    $("#preloader").hide()
                    if(response.status == "success"){

                        
                        $("#lastStep").hide() 
                        $("#successMessage").show()

                    }else{
                        console.error("Error submitting form");
                    }
                  
                },
                error: function(error) {
                    // Handle error response
                    console.error("Error submitting form:", error);
                }
            });
        })

        {% include "@CommonTemplate/Formules/formules.js" with {
                 "sessionModule" : "inputSessionModule" , 
                 "formulaId" : "input[name='session[formula]']" , 
                 "sessionTypeId" : "inputSessionType" ,
                 "addtionnalHoursId" : "#additionalHours"
        } %}

        {% include "@CommonTemplate/Formules/common.js" %}
       
    </script>

    

</body>
</html>
{% endblock %}