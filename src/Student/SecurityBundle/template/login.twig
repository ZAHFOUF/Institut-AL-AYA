<div>
    <div class="mb-4">
        <a href="/" class="d-block">
            <img style="width: 122px;
    margin-bottom: 11px;
    margin-top: -14px;;" src="{{asset('bundles/commontheme/images/logo/logo.png')}}" alt="">
        </a>
    </div>
    <h5 class="text-dark">Assalamou ‘alaykoum  </h5>
    <p class="text-muted">Identifie-toi pour continuer vers MERKEZ ALFAHM.</p>
</div>
{% if error %}
<div class="alert alert-danger alert-top-border alert-dismissible fade show mb-xl-0" role="alert">
    <i class="ri-error-warning-line me-3 align-middle fs-16 text-danger "></i>
    {{ error.messageKey  }}
</div>
{% endif %}

{% if app.session.flashBag.has('success') %}
    <div class="alert alert-success alert-dismissible alert-solid alert-label-icon fade show" role="alert">
        <i class="ri-notification-off-line label-icon"></i>
        {% for msg in app.flashes('success') %}
            {{ msg }}
        {% endfor %}
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endif %}


                   {% if app.session.flashBag.has('error') %}
     <div class="alert alert-danger alert-dismissible alert-solid alert-label-icon fade show mt-3" role="alert">
        <i class="ri-error-warning-line label-icon"></i>
        {% for msg in app.flashes('error') %}
            {{ msg }}
        {% endfor %}
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
           {% endif %}

<div class="mt-4">
    <form method="post">

        <div class="mb-3">
            <label for="username" class="form-label">E-mail</label>
            <input type="text" class="form-control" id="email" name="email" placeholder="Votre E-Mail" autocomplete="off" value="{{ lastUsername }}">
        </div>

        <div class="mb-3">
            <div class="float-end">
                <a href="" class="text-muted">Mot de passe oublie ?</a>
            </div>
            <label class="form-label" for="password-input">Mot de passe</label>
            <div class="position-relative auth-pass-inputgroup mb-3">
                <input type="password" class="form-control pe-5 password-input" id="inputPassword" name="password" placeholder="Mot de Passe" autocomplete="off">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" >
                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon" type="button" id="password-addon"><i class="ri-eye-fill align-middle"></i></button>
            </div>
        </div>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="" id="auth-remember-check">
            <label class="form-check-label" for="auth-remember-check">Se rappeler de moi</label>
        </div>

        <div class="mt-4">
            <button class="btn btn-success w-100" type="submit">S'identifier</button>
        </div>

        {# <div class="mt-4 text-center">
