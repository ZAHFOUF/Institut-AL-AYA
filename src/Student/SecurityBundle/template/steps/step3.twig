<div class="tab-pane fade  " id="step2" role="tabpanel" aria-labelledby="step3-tab">
    <div class="auth-card p-4">

       <!-- Title -->
       <div class="text-center mb-4">
        <h3 id="t6" class="mb-2 fw-semibold">Choisissez la formule qui vous correspond :</h3>
    </div>


    {% include "@CommonTemplate/Formules/formules.twig" with { titleHours : 'Heures totales :' , titleTrif : 'Tarif ' , frais: first is defined and first ? true : false , mt : true} %}
    
    {#}
    <div class="row g-3 mt-2"  >


        <template x-for="f in formulas">

            <div class="col-sm-3">
                <input class="form-check-input" type="radio" name="session[formula]" x-bind:id="`forfait${f.id}`" x-bind:value="f.id" x-bind:data-hours="f.hours" x-bind:data-price="f.price" style="cursor: pointer;" x-on:click="refresh()">
                <label x-text="`Forfait ${f.hours}h (${f.daysPerWeek} jours/semaine)`" class="form-check-label" x-bind:for="`forfait${f.id}`"> </label>
            </div>

            </template>
    
    </div>
    
    <div class="mt-4 mb-2" style="width: 32%;">
        <label for="additionalHours">Heures supplémentaires</label>
        <input type="number" id="additionalHours" name="session[additionalHours]" class="form-control" placeholder="Heures supplémentaires" value="0" x-on:change="refresh()">
    </div>

    <div style="font-size: 15px;" class="mt-4 mb-2">
        <p><strong x-text="'Heures totales :' +  totalHours "></strong></p>
    </div>

    <div style="font-size: 20px;" class="mt-4 mb-2">
        <p><strong x-text="'Tarif ' +  price + '€' " > </strong></p>
    </div> {#}
   
    </div>

    
    <div class="elementor-widget-container">

         
        <p style="display: none;" id="binomeMode"><span style="font-weight: 500;"><img style="width: 19px;" decoding="async" class="emoji" role="img" draggable="false" src="https://s.w.org/images/core/emoji/15.0.3/svg/26a0.svg" alt="⚠️"> Vous devez inscrire votre collaborateur en mode binôme via un lien d'invitation qui sera partagé d'abord, au moment de votre inscription.</span></p>


        {% if first is defined and first %}

        <p><span style="font-weight: 500;"><img style="width: 19px;" decoding="async" class="emoji" role="img" draggable="false" src="https://s.w.org/images/core/emoji/15.0.3/svg/26a0.svg" alt="⚠️"> 5 € de frais d’inscription sur toutes nos formules, à payer une seule fois lors de la première inscription.</span></p>
    
        {% endif %}

        <p><span style="font-weight: 500;"><img style="width: 19px;" decoding="async" class="emoji" role="img" draggable="false" src="https://s.w.org/images/core/emoji/15.0.3/svg/26a0.svg" alt="⚠️"> L’heure en plus dans le calendrier mensuel (en plus du forfait choisi) sera payer 6 €.</span></p>							
    </div>
   
    <div class="d-flex align-items-start gap-3 mt-4">
        <button id="save3" type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="step3-tab"><i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Suivant</button>
    </div>
    
    </div>
